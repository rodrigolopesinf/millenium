<button type="@Type" class="btn @ButtonClass @Class" @onclick="HandleClick" disabled="@(Disabled || IsLoading)" style="@StyleAttribute">
    @if (IsLoading)
    {
        <i class="fa fa-refresh fa-spin" style="margin-right: 6px;"></i>
        <span>@(string.IsNullOrEmpty(LoadingText) ? "Carregando..." : LoadingText)</span>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Icon))
        {
            <i class="@Icon" style="margin-right: 6px;"></i>
        }
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "primary"; // primary, default, danger, success, warning
    [Parameter] public string StyleAttribute { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ButtonClass => Style switch
    {
        "primary" => "btn-primary",
        "danger" => "btn-danger",
        "success" => "btn-success",
        "warning" => "btn-warning",
        _ => "btn-default"
    };

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!IsLoading && !Disabled && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}
