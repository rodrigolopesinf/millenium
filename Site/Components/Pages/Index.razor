<!-- Seção Contato Reativa -->
<section class="contact-section" id="contato">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info-panel">
                <span class="section-tag">Fale Conosco</span>
                <h2 class="contact-info-title">Pronto para aumentar a segurança do seu negócio?</h2>
                <p style="margin-bottom: 24px; color: var(--gray-500);">Preencha o formulário e nossa equipe comercial retornará o contato com o portfólio completo de planos comerciais por faturamento de consumo.</p>
                
                <div class="contact-cards-container">
                    <div class="contact-detail-card">
                        <div class="contact-detail-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </div>
                        <div>
                            <h4>Central Telefônica & WhatsApp</h4>
                            <p>(21) 99107-8726</p>
                            <p>(21) 2423-5222 | (21) 3796-4460</p>
                        </div>
                    </div>
    
                    <div class="contact-detail-card">
                        <div class="contact-detail-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        </div>
                        <div>
                            <h4>E-mail de Contato</h4>
                            <p>consulta.cadastral@millecad.com.br</p>
                        </div>
                    </div>
                </div>
            </div>
    
            <div class="contact-form-panel">
                @if (exibirMensagemSucesso)
                {
                    <div class="alert alert-success" style="border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 500;">
                        Sua mensagem foi enviada com sucesso! Em breve nossa equipe entrará em contato.
                    </div>
                }
                @if (exibirMensagemErro)
                {
                    <div class="alert alert-danger" style="border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 500;">
                        @mensagemErroTexto
                    </div>
                }
    
                <EditForm Model="contatoModel" OnValidSubmit="SubmeterContato">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group-row">
                        <div class="form-group">
                            <label for="nome" class="form-label">Nome Completo</label>
                            <input type="text" id="nome" @bind="contatoModel.Nome" class="form-control" placeholder="Seu nome" required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;" />
                        </div>
                        
                        <div class="form-group">
                            <label for="email" class="form-label">E-mail Corporativo</label>
                            <input type="email" id="email" @bind="contatoModel.Email" class="form-control" placeholder="seu.nome@empresa.com" required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;" />
                        </div>
                    </div>
    
                    <div class="form-group" style="margin-top: 10px;">
                        <label for="assunto" class="form-label">Assunto de Interesse</label>
                        <input type="text" id="assunto" @bind="contatoModel.Assunto" class="form-control" placeholder="Ex: Pesquisas para RH, Orçamento, etc." required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;" />
                    </div>
    
                    <div class="form-group" style="margin-top: 10px;">
                        <label for="mensagem" class="form-label">Mensagem</label>
                        <textarea id="mensagem" @bind="contatoModel.Mensagem" class="form-control" placeholder="Descreva brevemente a sua necessidade cadastral..." required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 120px; resize: vertical;"></textarea>
                    </div>
    
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 20px; height: 42px; border-radius: var(--radius-md); font-weight: 600;">Enviar Solicitação</button>
                </EditForm>
            </div>
        </div>
    </div>
</section>

@code {
    private string abaAtiva = "tab-social";
    private ContatoForm contatoModel = new ContatoForm();
    private bool exibirMensagemSucesso = false;
    private bool exibirMensagemErro = false;
    private string mensagemErroTexto = "Por favor, preencha todos os campos do formulário.";

    private void SelecionarAba(string tabId)
    {
        abaAtiva = tabId;
    }

    private async Task SubmeterContato()
    {
        if (string.IsNullOrWhiteSpace(contatoModel.Nome) || 
            string.IsNullOrWhiteSpace(contatoModel.Email) || 
            string.IsNullOrWhiteSpace(contatoModel.Assunto) || 
            string.IsNullOrWhiteSpace(contatoModel.Mensagem))
        {
            mensagemErroTexto = "Por favor, preencha todos os campos do formulário.";
            exibirMensagemErro = true;
            exibirMensagemSucesso = false;
            return;
        }

        exibirMensagemErro = false;
        exibirMensagemSucesso = false;

        // Armazena temporariamente os valores para o envio do e-mail
        var nome = contatoModel.Nome;
        var email = contatoModel.Email;
        var assunto = contatoModel.Assunto;
        var mensagem = contatoModel.Mensagem;

        // Limpa os campos do formulário de imediato na UI para uma melhor UX
        contatoModel = new ContatoForm();

        try
        {
            // Monta o corpo do email em HTML formatado e limpo
            string corpoEmail = $@"
                <h3>Nova mensagem de contato recebida do site</h3>
                <p><strong>Nome Completo:</strong> {nome}</p>
                <p><strong>E-mail Corporativo:</strong> {email}</p>
                <p><strong>Assunto de Interesse:</strong> {assunto}</p>
                <p><strong>Mensagem:</strong></p>
                <p style='white-space: pre-line; background-color: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; color: #334155;'>{mensagem}</p>
            ";

            // Envia em background (assíncrono) para não travar o circuito do Blazor com o timeout do SMTP síncrono
            await Task.Run(() =>
            {
                new Email(
                    de: email,
                    deNome: nome,
                    para: "consulta.cadastral@millecad.com.br",
                    assunto: $"[Fale Conosco] {assunto}",
                    mensagem: corpoEmail
                );
            });

            exibirMensagemSucesso = true;
        }
        catch (Exception ex)
        {
            // Captura o erro real do SMTP e exibe na tela para testes claros
            mensagemErroTexto = $"Falha de conexão com o servidor de e-mail (SMTP). Detalhes: {ex.Message}";
            exibirMensagemErro = true;
        }
    }

    public class ContatoForm
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Assunto { get; set; } = "";
        public string Mensagem { get; set; } = "";
    }
}
