@page "/Blazor/Usuario"
@attribute [Authorize]
@inject IUsuarioAppService UsuarioApp
@inject INivelAppService NivelApp
@inject IClienteAppService ClienteApp
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Millenium.Domain.Entity
@using Millenium.Util

<PageTitle>Gestão de Usuários - Millenium</PageTitle>

<div class="dashboard-container" style="padding: 10px;">
    <!-- Cabeçalho Minimalista da Tela -->
    <div class="page-header-container" style="margin-bottom: 24px;">
        <h3 style="margin: 0; font-size: 24px; font-weight: 700; color: var(--dark-bg); font-family: 'Outfit', sans-serif;">Gestão de Usuários</h3>
        <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 14px;">Cadastre e gerencie os usuários e níveis de acesso do sistema.</p>
    </div>

    <!-- Toolbar de Busca e Filtros Integrada -->
    <div class="search-toolbar-custom" style="background-color: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
        <div class="toolbar-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="toolbar-title" style="font-weight: 700; font-size: 15px; color: var(--dark-bg); display: flex; align-items: center; gap: 8px; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-filter"></i> Filtros de Pesquisa
            </span>
            <button class="btn btn-primary" @onclick="AbrirNovoDrawer" style="display: flex; align-items: center; gap: 8px; border-radius: var(--radius-md); font-weight: 600; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-user-plus"></i> Novo Usuário
            </button>
        </div>
        
        <form @onsubmit="Filtrar" style="margin: 0; padding: 0;">
            <div class="row">
                <div class="form-group col-md-5">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Nome</label>
                    <input type="text" @bind="filtroNome" @onkeyup="HandleFiltroEnter" class="form-control" placeholder="Buscar por nome..." style="border-radius: var(--radius-md); border-color: var(--border-color); text-transform: uppercase;" />
                </div>
                <div class="form-group col-md-3">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Ativo</label>
                    <select class="form-control" @bind="filtroAtivo" style="border-radius: var(--radius-md); border-color: var(--border-color);">
                        <option value="todos">Todos</option>
                        <option value="true">Sim</option>
                        <option value="false">Não</option>
                    </select>
                </div>
                <div class="form-group col-md-4" style="display: flex; align-items: flex-end; justify-content: flex-start; gap: 8px; height: 59px;">
                    <button type="submit" class="btn btn-primary" title="Buscar registros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md);">
                        <i class="fa fa-search"></i>
                    </button>
                    <button type="button" class="btn btn-default" @onclick="LimparFiltros" title="Limpar filtros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fa fa-rotate-left"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Tabela de Resultados -->
    @if (carregando)
    {
        <div style="padding: 60px; text-align: center; color: var(--text-muted);">
            <i class="fa fa-refresh fa-spin" style="font-size: 32px; margin-bottom: 16px; color: var(--primary-color);"></i>
            <p style="font-weight: 600;">Carregando registros...</p>
        </div>
    }
    else
    {
        <MilleniumTable TItem="Usuario" Items="usuariosFiltrados" ColSpan="4" PageSize="10">
            <HeaderTemplate>
                <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Nome</th>
                <th style="width: 150px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Ativo</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Editar</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Excluir</th>
            </HeaderTemplate>
            <RowTemplate Context="item">
                <td style="padding: 14px 16px; font-weight: 500; color: var(--dark-bg);">@item.Nome</td>
                <td style="text-align: center; padding: 14px 16px;">
                    @if (item.Ativo == true)
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.2);">
                            SIM
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.2);">
                            NÃO
                        </span>
                    }
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    @if (nivelUsuario == 2 && item.IdNivel == 2)
                    {
                        <i class="fa fa-lock" style="font-size: 16px; color: var(--text-muted);" title="Bloqueado para Operadores"></i>
                    }
                    else
                    {
                        <button class="btn btn-link" @onclick="() => AbrirEditarDrawer(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Editar">
                            <i class="fa fa-edit" style="font-size: 16px;"></i>
                        </button>
                    }
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    @if (nivelUsuario == 2 && item.IdNivel == 2)
                    {
                        <i class="fa fa-lock" style="font-size: 16px; color: var(--text-muted);" title="Bloqueado para Operadores"></i>
                    }
                    else
                    {
                        <button class="btn btn-link" @onclick="() => ConfirmarExclusao(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Excluir">
                            <i class="fa fa-trash-o" style="font-size: 16px;"></i>
                        </button>
                    }
                </td>
            </RowTemplate>
        </MilleniumTable>
    }
</div>

<!-- Drawer de Cadastro / Edição -->
<MilleniumDrawer @bind-IsOpen="drawerAberto" Title="@drawerTitulo" Size="md">
    <ChildContent>
        <EditForm Model="usuarioEdicao" OnSubmit="HandleSubmit" style="display: flex; flex-direction: column; height: 100%;">
            <DataAnnotationsValidator />
            
            <div style="flex-grow: 1; padding-bottom: 20px; max-height: 70vh; overflow-y: auto; padding-right: 5px;">
                <div class="row">
                    <div class="form-group col-md-12" style="margin-bottom: 15px;">
                        <MilleniumInput Label="Nome" @bind-Value="usuarioEdicao.Nome" Placeholder="NOME COMPLETO..." Required="true" Maxlength="255" />
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px;">
                        <MilleniumInput Label="Apelido" @bind-Value="usuarioEdicao.Apelido" Placeholder="APELIDO..." Required="false" Maxlength="50" />
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px;">
                        <MilleniumInput Label="Celular" @bind-Value="usuarioEdicao.Celular" Placeholder="(00) 00000-0000" Required="false" Maxlength="15" />
                    </div>

                    <div class="form-group col-md-12" style="margin-bottom: 15px;">
                        <MilleniumInput Label="Email" @bind-Value="usuarioEdicao.Email" Placeholder="EMAIL@DOMINIO.COM" Required="true" Maxlength="255" />
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Nível de Acesso</label>
                        <select class="form-control" @bind="usuarioEdicao.IdNivel" required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;">
                            <option value="">SELECIONE</option>
                            @foreach (var n in niveis)
                            {
                                <option value="@n.IdNivel">@n.Descricao</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Cliente</label>
                        <select class="form-control" @bind="selectedClienteId" required="@(usuarioEdicao.IdNivel == 3)" style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;">
                            <option value="0">SELECIONE</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.IdCliente">@c.CodigoCliente - @(c.Cnpj != null ? c.NomeFantasia : c.Nome)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px;">
                        <MilleniumInput Label="Login" @bind-Value="usuarioEdicao.Login" Placeholder="LOGIN DE ACESSO..." Required="true" Maxlength="50" />
                    </div>

                    <div class="form-group col-md-6" style="margin-bottom: 15px; display: flex; align-items: flex-end; gap: 8px;">
                        <div style="flex-grow: 1;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Senha</label>
                            <input type="password" @bind="senhaUI" class="form-control" placeholder="SENHA" maxlength="20" required="@(usuarioEdicao.IdUsuario == 0)" style="height: 42px; border-radius: var(--radius-md); border-color: var(--border-color);" />
                        </div>
                        @if (usuarioEdicao.IdUsuario > 0)
                        {
                            <button type="button" class="btn btn-default" @onclick="ResetarSenhaUI" style="height: 42px; border-radius: var(--radius-md); font-weight: 600; font-size: 12px; border-color: var(--border-color);" title="Resetar para 123456">
                                Resetar
                            </button>
                        }
                    </div>

                    <div class="form-group col-md-12" style="margin-bottom: 15px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">A Senha Expira?</label>
                        <div style="display: flex; gap: 20px;">
                            <label style="font-weight: 500; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                <input type="radio" name="radExpira" checked="@senhaExpiraUI" @onchange="() => SetSenhaExpira(true)" style="accent-color: var(--primary-color);" /> Sim, expira
                            </label>
                            <label style="font-weight: 500; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                <input type="radio" name="radExpira" checked="@(!senhaExpiraUI)" @onchange="() => SetSenhaExpira(false)" style="accent-color: var(--primary-color);" /> Nunca expira
                            </label>
                        </div>
                    </div>

                    @if (senhaExpiraUI)
                    {
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Validade da Senha</label>
                            <input type="date" @bind="validadeSenhaUI" class="form-control" style="height: 42px; border-radius: var(--radius-md); border-color: var(--border-color);" />
                        </div>
                    }

                    <div class="form-group col-md-12" style="margin-bottom: 15px; display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                        <InputCheckbox @bind-Value="usuarioEdicaoAtivo" id="chkUsuarioAtivo" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;" />
                        <label for="chkUsuarioAtivo" style="font-weight: 600; font-size: 14px; margin: 0; cursor: pointer; color: var(--dark-bg);">
                            Usuário ativo no sistema
                        </label>
                    </div>
                </div>
            </div>

            <div style="padding: 16px 0 0 0; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 12px; background-color: #ffffff;">
                <button type="button" class="btn btn-default" @onclick="FecharDrawer" style="border-radius: var(--radius-md); border-color: var(--border-color); font-weight: 600;">Cancelar</button>
                <MilleniumButton Type="submit" Text="Salvar" Icon="fa fa-save" IsLoading="@salvando" LoadingText="Salvando..." Style="primary" StyleAttribute="border-radius: var(--radius-md); font-weight: 600;" />
            </div>
        </EditForm>
    </ChildContent>
</MilleniumDrawer>

@code {
    private bool carregando = true;
    private bool salvando = false;
    private bool drawerAberto = false;
    private string drawerTitulo = "";
    
    private string filtroNome = "";
    private string filtroAtivo = "todos";

    private List<Usuario> todosUsuarios = new();
    private List<Usuario> usuariosFiltrados = new();
    private List<Nivel> niveis = new();
    private List<Cliente> clientes = new();

    private Usuario usuarioEdicao = new();
    private bool usuarioEdicaoAtivo = true;
    private string senhaUI = "";
    private bool enviarEmailReset = false;
    private bool senhaExpiraUI = false;
    private DateTime validadeSenhaUI = DateTime.Now.AddDays(90);
    private int nivelUsuario = 0;
    private Usuario? usuarioLogado;
    private int selectedClienteId = 0;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDropdownsAsync();
        await CarregarDadosAsync();
    }

    private async Task CarregarDropdownsAsync()
    {
        try
        {
            var userName = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            int currentNivel = 0;
            if (!string.IsNullOrEmpty(userName))
            {
                var usr = UsuarioApp.ObterUsuarioPeloNome(userName);
                currentNivel = usr?.IdNivel ?? 0;
            }

            await Task.Run(() =>
            {
                var listNiveis = NivelApp.GetAll()?.OrderBy(x => x.Descricao).ToList() ?? new List<Nivel>();
                if (currentNivel == 2)
                {
                    listNiveis = listNiveis.Where(x => x.IdNivel == 3).ToList();
                }
                niveis = listNiveis;

                clientes = ClienteApp.GetAll()?.Where(x => x.Excluido != true && x.Ativo).OrderBy(x => x.Nome).ToList() ?? new List<Cliente>();
            });
        }
        catch {}
    }

    private async Task CarregarDadosAsync()
    {
        carregando = true;
        try
        {
            var userName = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            if (!string.IsNullOrEmpty(userName))
            {
                usuarioLogado = UsuarioApp.ObterUsuarioPeloNome(userName);
                nivelUsuario = usuarioLogado?.IdNivel ?? 0;
                
                if (nivelUsuario == 3)
                {
                    NavigationManager.NavigateTo("/Blazor/Solicitacao");
                    return;
                }
            }

            await Task.Run(() =>
            {
                var query = UsuarioApp.GetAll()?.Where(x => x.Excluido != true);
                if (nivelUsuario == 2)
                {
                    query = query?.Where(x => x.IdNivel == 3);
                }
                todosUsuarios = query?.ToList() ?? new List<Usuario>();
            });
            Filtrar();
        }
        catch (Exception) {}
        finally
        {
            carregando = false;
        }
    }

    private void Filtrar()
    {
        var query = todosUsuarios.AsQueryable();

        if (!string.IsNullOrWhiteSpace(filtroNome))
        {
            query = query.Where(x => x.Nome.Contains(filtroNome, StringComparison.OrdinalIgnoreCase));
        }

        if (filtroAtivo != "todos")
        {
            bool ativoBool = bool.Parse(filtroAtivo);
            query = query.Where(x => x.Ativo == ativoBool);
        }

        usuariosFiltrados = query.ToList();
    }

    private void LimparFiltros()
    {
        filtroNome = "";
        filtroAtivo = "todos";
        Filtrar();
    }

    private void HandleFiltroEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Filtrar();
        }
    }

    private void SetSenhaExpira(bool expira)
    {
        senhaExpiraUI = expira;
    }

    private void ResetarSenhaUI()
    {
        senhaUI = "123456";
        enviarEmailReset = true;
    }

    private void AbrirNovoDrawer()
    {
        usuarioEdicao = new Usuario { Ativo = true, Nome = "", Login = "", Senha = "" };
        selectedClienteId = 0;
        usuarioEdicaoAtivo = true;
        senhaUI = "";
        enviarEmailReset = false;
        senhaExpiraUI = false;
        validadeSenhaUI = DateTime.Now.AddDays(90);
        drawerTitulo = "Novo Usuário";
        drawerAberto = true;
    }

    private void AbrirEditarDrawer(Usuario item)
    {
        var senhaDescripto = "";
        try { if (!string.IsNullOrEmpty(item.Senha)) senhaDescripto = Md5Crypt.Descriptografar(item.Senha); } catch {}

        usuarioEdicao = new Usuario
        {
            IdUsuario = item.IdUsuario,
            Nome = item.Nome,
            Apelido = item.Apelido,
            Celular = item.Celular,
            Email = item.Email,
            IdNivel = item.IdNivel,
            IdCliente = item.IdCliente,
            Login = item.Login,
            Senha = item.Senha,
            ValidadeSenha = item.ValidadeSenha,
            Ativo = item.Ativo,
            DataHoraCriacao = item.DataHoraCriacao,
            IdUsuarioCriacao = item.IdUsuarioCriacao
        };
        selectedClienteId = item.IdCliente ?? 0;
        usuarioEdicaoAtivo = item.Ativo;
        senhaUI = senhaDescripto;
        enviarEmailReset = false;
        senhaExpiraUI = item.ValidadeSenha.HasValue;
        validadeSenhaUI = item.ValidadeSenha ?? DateTime.Now.AddDays(90);
        drawerTitulo = "Editar Usuário";
        drawerAberto = true;
    }

    private void FecharDrawer()
    {
        drawerAberto = false;
    }

    private async Task SalvarUsuario()
    {
        if (salvando) return;
        salvando = true;
        
        try
        {
            usuarioEdicao.Nome = usuarioEdicao.Nome.ToUpper().Trim();
            if (!string.IsNullOrEmpty(usuarioEdicao.Apelido))
                usuarioEdicao.Apelido = usuarioEdicao.Apelido.ToUpper().Trim();
            
            usuarioEdicao.Ativo = usuarioEdicaoAtivo;
            usuarioEdicao.IdCliente = selectedClienteId > 0 ? selectedClienteId : null;
            
            if (senhaExpiraUI)
                usuarioEdicao.ValidadeSenha = validadeSenhaUI;
            else
                usuarioEdicao.ValidadeSenha = null;

            if (!string.IsNullOrEmpty(senhaUI))
                usuarioEdicao.Senha = Md5Crypt.Criptografar(senhaUI);

            await Task.Run(() =>
            {
                if (usuarioEdicao.IdUsuario == 0)
                {
                    // Novo Registro
                    usuarioEdicao.DataHoraCriacao = DateTime.Now;
                    usuarioEdicao.IdUsuarioCriacao = 1;
                    usuarioEdicao.Excluido = false;
                    UsuarioApp.Add(usuarioEdicao);
                }
                else
                {
                    // Edição
                    var existente = UsuarioApp.GetById(usuarioEdicao.IdUsuario);
                    if (existente != null)
                    {
                        existente.Nome = usuarioEdicao.Nome;
                        existente.Apelido = usuarioEdicao.Apelido;
                        existente.Celular = usuarioEdicao.Celular;
                        existente.Email = usuarioEdicao.Email;
                        existente.IdNivel = usuarioEdicao.IdNivel;
                        existente.IdCliente = usuarioEdicao.IdCliente;
                        existente.Login = usuarioEdicao.Login;
                        existente.Senha = usuarioEdicao.Senha;
                        existente.ValidadeSenha = usuarioEdicao.ValidadeSenha;
                        existente.Ativo = usuarioEdicao.Ativo;
                        existente.DataHoraAlteracao = DateTime.Now;
                        existente.IdUsuarioAlteracao = 1;
                        UsuarioApp.Update(existente);

                        if (enviarEmailReset)
                        {
                            try
                            {
                                new Millenium.Infra.Data.Email.Email(existente, "123456");
                            }
                            catch {}
                        }
                    }
                }
            });

            await CarregarDadosAsync();
            FecharDrawer();
        }
        catch (Exception) {}
        finally
        {
            salvando = false;
        }
    }

    private async Task ConfirmarExclusao(Usuario item)
    {
        if (nivelUsuario == 2 && item.IdNivel != 3)
        {
            await JS.InvokeVoidAsync("alert", "Operadores só possuem permissão para excluir usuários Gestores.");
            return;
        }

        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o usuário '{item.Nome}'?");
        if (confirmado)
        {
            try
            {
                await Task.Run(() =>
                {
                    var existente = UsuarioApp.GetById(item.IdUsuario);
                    if (existente != null)
                    {
                        existente.Excluido = true;
                        existente.DataHoraExclusao = DateTime.Now;
                        existente.IdUsuarioExclusao = 1;
                        UsuarioApp.Update(existente);
                    }
                });
                await CarregarDadosAsync();
            }
            catch (Exception) {}
        }
    }

    private async Task HandleSubmit(EditContext editContext)
    {
        if (nivelUsuario == 2 && usuarioEdicao.IdNivel != 3)
        {
            await JS.InvokeVoidAsync("alert", "Operadores só possuem permissão para cadastrar/editar usuários Gestores.");
            return;
        }

        var senhaOriginal = usuarioEdicao.Senha;
        
        // Se for novo registro e não houver senha digitada, impede a submissão
        if (usuarioEdicao.IdUsuario == 0 && string.IsNullOrEmpty(senhaUI))
        {
            return;
        }

        if (!string.IsNullOrEmpty(senhaUI))
        {
            usuarioEdicao.Senha = senhaUI; // Atribui temporariamente para passar no validador
        }

        if (editContext.Validate())
        {
            usuarioEdicao.Senha = senhaOriginal; // Restaura para que o SalvarUsuario criptografe corretamente
            await SalvarUsuario();
        }
        else
        {
            usuarioEdicao.Senha = senhaOriginal;
        }
    }
}
