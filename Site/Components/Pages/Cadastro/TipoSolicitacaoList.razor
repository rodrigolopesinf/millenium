@page "/Blazor/TipoSolicitacao"
@attribute [Authorize]
@inject ITipoSolicitacaoAppService TipoSolicitacaoApp
@inject IUsuarioAppService UsuarioApp
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Millenium.Domain.Entity

<PageTitle>Tipo de Solicitação - Millenium</PageTitle>

<div class="dashboard-container" style="padding: 10px;">
    <!-- Cabeçalho Minimalista da Tela -->
    <div class="page-header-container" style="margin-bottom: 24px;">
        <h3 style="margin: 0; font-size: 24px; font-weight: 700; color: var(--dark-bg); font-family: 'Outfit', sans-serif;">Tipo de Solicitação</h3>
        <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 14px;">Cadastre e gerencie os tipos e categorias de pesquisas cadastrais do sistema.</p>
    </div>

    <!-- Toolbar de Busca e Filtros Integrada -->
    <div class="search-toolbar-custom" style="background-color: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
        <div class="toolbar-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="toolbar-title" style="font-weight: 700; font-size: 15px; color: var(--dark-bg); display: flex; align-items: center; gap: 8px; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-filter"></i> Filtros de Pesquisa
            </span>
            <button class="btn btn-primary" @onclick="AbrirNovoDrawer" style="display: flex; align-items: center; gap: 8px; border-radius: var(--radius-md); font-weight: 600; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-plus-circle"></i> Novo Tipo de Solicitação
            </button>
        </div>
        
        <div class="row">
            <div class="form-group col-md-5">
                <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Descrição</label>
                <input type="text" @bind="filtroDescricao" @bind:event="oninput" @onkeyup="HandleFiltroEnter" class="form-control" placeholder="EX: PESQUISA SOCIAL, FINANCEIRA..." style="border-radius: var(--radius-md); border-color: var(--border-color); text-transform: uppercase;" />
            </div>
            <div class="form-group col-md-3">
                <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Ativo</label>
                <select class="form-control" @bind="filtroAtivo" style="border-radius: var(--radius-md); border-color: var(--border-color);">
                    <option value="todos">Todos</option>
                    <option value="true">Sim</option>
                    <option value="false">Não</option>
                </select>
            </div>
            <div class="form-group col-md-4" style="display: flex; align-items: flex-end; justify-content: flex-start; gap: 8px; height: 59px;">
                <button class="btn btn-primary" @onclick="Filtrar" title="Buscar registros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md);">
                    <i class="fa fa-search"></i>
                </button>
                <button class="btn btn-default" @onclick="LimparFiltros" title="Limpar filtros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); border-color: var(--border-color);">
                    <i class="fa fa-rotate-left"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Tabela de Resultados -->
    @if (carregando)
    {
        <div style="padding: 60px; text-align: center; color: var(--text-muted);">
            <i class="fa fa-refresh fa-spin" style="font-size: 32px; margin-bottom: 16px; color: var(--primary-color);"></i>
            <p style="font-weight: 600;">Carregando registros...</p>
        </div>
    }
    else
    {
        <MilleniumTable TItem="TipoSolicitacao" Items="tiposFiltrados" ColSpan="4" PageSize="10">
            <HeaderTemplate>
                <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Descrição</th>
                <th style="width: 150px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Ativo</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Editar</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Excluir</th>
            </HeaderTemplate>
            <RowTemplate Context="item">
                <td style="padding: 14px 16px; font-weight: 500; color: var(--dark-bg);">@item.Descricao</td>
                <td style="text-align: center; padding: 14px 16px;">
                    @if (item.Ativo == true)
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.2);">
                            SIM
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.2);">
                            NÃO
                        </span>
                    }
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    <button class="btn btn-link" @onclick="() => AbrirEditarDrawer(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Editar">
                        <i class="fa fa-edit" style="font-size: 16px;"></i>
                    </button>
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    <button class="btn btn-link" @onclick="() => ConfirmarExclusao(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Excluir">
                        <i class="fa fa-trash-o" style="font-size: 16px;"></i>
                    </button>
                </td>
            </RowTemplate>
        </MilleniumTable>
    }
</div>

<!-- Drawer de Cadastro / Edição -->
<MilleniumDrawer @bind-IsOpen="drawerAberto" Title="@drawerTitulo" Size="sm">
    <ChildContent>
        <EditForm Model="tipoEdicao" OnValidSubmit="SalvarTipoSolicitacao" style="display: flex; flex-direction: column; height: 100%;">
            <DataAnnotationsValidator />
            
            <div style="flex-grow: 1; padding-bottom: 20px;">
                <div style="margin-bottom: 20px;">
                    <MilleniumInput Label="Descrição" @bind-Value="tipoEdicao.Descricao" Placeholder="DIGITE A DESCRIÇÃO..." Required="true" Maxlength="255" />
                </div>

                <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <InputCheckbox @bind-Value="tipoEdicaoAtivo" id="chkAtivo" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;" />
                    <label for="chkAtivo" style="font-weight: 600; font-size: 14px; margin: 0; cursor: pointer; color: var(--dark-bg);">
                        Tipo de solicitação ativo no sistema
                    </label>
                </div>
            </div>

            <div style="padding: 16px 0 0 0; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="btn btn-default" @onclick="FecharDrawer" style="border-radius: var(--radius-md); border-color: var(--border-color); font-weight: 600;">Cancelar</button>
                <MilleniumButton Type="submit" Text="Salvar" Icon="fa fa-save" IsLoading="@salvando" LoadingText="Salvando..." Style="primary" StyleAttribute="border-radius: var(--radius-md); font-weight: 600;" />
            </div>
        </EditForm>
    </ChildContent>
</MilleniumDrawer>

@code {
    private bool carregando = true;
    private bool salvando = false;
    private bool drawerAberto = false;
    private string drawerTitulo = "";
    
    private string filtroDescricao = "";
    private string filtroAtivo = "todos";

    private List<TipoSolicitacao> todosTipos = new();
    private List<TipoSolicitacao> tiposFiltrados = new();

    private TipoSolicitacao tipoEdicao = new();
    private bool tipoEdicaoAtivo = true;

    protected override async Task OnInitializedAsync()
    {
        var userLogin = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
        if (!string.IsNullOrEmpty(userLogin))
        {
            var usr = UsuarioApp.ObterUsuarioPeloNome(userLogin);
            if (usr?.IdNivel == 3)
            {
                NavigationManager.NavigateTo("/Blazor/Solicitacao");
                return;
            }
        }

        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        carregando = true;
        try
        {
            await Task.Run(() =>
            {
                todosTipos = TipoSolicitacaoApp.GetAll()
                    ?.Where(x => x.Excluido != true)
                    .OrderBy(x => x.Descricao)
                    .ToList() ?? new List<TipoSolicitacao>();
            });
            Filtrar();
        }
        catch (Exception)
        {
            // Tratar erro
        }
        finally
        {
            carregando = false;
        }
    }

    private void Filtrar()
    {
        var query = todosTipos.AsQueryable();

        if (!string.IsNullOrWhiteSpace(filtroDescricao))
        {
            query = query.Where(x => x.Descricao.Contains(filtroDescricao, StringComparison.OrdinalIgnoreCase));
        }

        if (filtroAtivo != "todos")
        {
            bool ativoBool = bool.Parse(filtroAtivo);
            query = query.Where(x => x.Ativo == ativoBool);
        }

        tiposFiltrados = query.ToList();
    }

    private void LimparFiltros()
    {
        filtroDescricao = "";
        filtroAtivo = "todos";
        Filtrar();
    }

    private void HandleFiltroEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Filtrar();
        }
    }

    private void AbrirNovoDrawer()
    {
        tipoEdicao = new TipoSolicitacao { Ativo = true, Descricao = "" };
        tipoEdicaoAtivo = true;
        drawerTitulo = "Novo Tipo de Solicitação";
        drawerAberto = true;
    }

    private void AbrirEditarDrawer(TipoSolicitacao item)
    {
        tipoEdicao = new TipoSolicitacao
        {
            IdTipoSolicitacao = item.IdTipoSolicitacao,
            Descricao = item.Descricao,
            Ativo = item.Ativo,
            DataHoraCriacao = item.DataHoraCriacao,
            IdUsuarioCriacao = item.IdUsuarioCriacao
        };
        tipoEdicaoAtivo = item.Ativo ?? true;
        drawerTitulo = "Editar Tipo de Solicitação";
        drawerAberto = true;
    }

    private void FecharDrawer()
    {
        drawerAberto = false;
    }

    private async Task SalvarTipoSolicitacao()
    {
        if (salvando) return;
        salvando = true;
        
        try
        {
            tipoEdicao.Descricao = tipoEdicao.Descricao.ToUpper().Trim();
            tipoEdicao.Ativo = tipoEdicaoAtivo;

            await Task.Run(() =>
            {
                if (tipoEdicao.IdTipoSolicitacao == 0)
                {
                    // Novo Registro
                    tipoEdicao.DataHoraCriacao = DateTime.Now;
                    tipoEdicao.IdUsuarioCriacao = 1;
                    tipoEdicao.Excluido = false;
                    TipoSolicitacaoApp.Add(tipoEdicao);
                }
                else
                {
                    // Edição
                    var existente = TipoSolicitacaoApp.GetById(tipoEdicao.IdTipoSolicitacao);
                    if (existente != null)
                    {
                        existente.Descricao = tipoEdicao.Descricao;
                        existente.Ativo = tipoEdicao.Ativo;
                        existente.DataHoraAlteracao = DateTime.Now;
                        existente.IdUsuarioAlteracao = 1;
                        TipoSolicitacaoApp.Update(existente);
                    }
                }
            });

            await CarregarDadosAsync();
            FecharDrawer();
        }
        catch (Exception)
        {
            // Tratar erro
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ConfirmarExclusao(TipoSolicitacao item)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o tipo de solicitação '{item.Descricao}'?");
        if (confirmado)
        {
            try
            {
                await Task.Run(() =>
                {
                    var existente = TipoSolicitacaoApp.GetById(item.IdTipoSolicitacao);
                    if (existente != null)
                    {
                        existente.Excluido = true;
                        existente.DataHoraExclusao = DateTime.Now;
                        existente.IdUsuarioExclusao = 1;
                        TipoSolicitacaoApp.Update(existente);
                    }
                });
                await CarregarDadosAsync();
            }
            catch (Exception)
            {
                // Tratar erro
            }
        }
    }
}
