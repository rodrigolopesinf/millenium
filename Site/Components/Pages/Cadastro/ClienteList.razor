    private async Task SalvarCliente()
    {
        if (salvando) return;
        salvando = true;

        try
        {
            // Padronizações
            if (!string.IsNullOrEmpty(clienteEdicao.Nome)) clienteEdicao.Nome = clienteEdicao.Nome.ToUpper().Trim();
            if (!string.IsNullOrEmpty(clienteEdicao.RazaoSocial)) clienteEdicao.RazaoSocial = clienteEdicao.RazaoSocial.ToUpper().Trim();
            if (!string.IsNullOrEmpty(clienteEdicao.NomeFantasia)) clienteEdicao.NomeFantasia = clienteEdicao.NomeFantasia.ToUpper().Trim();

            enderecoEdicao.Logradouro = enderecoEdicao.Logradouro.ToUpper().Trim();
            enderecoEdicao.Bairro = enderecoEdicao.Bairro.ToUpper().Trim();
            enderecoEdicao.Cidade = enderecoEdicao.Cidade.ToUpper().Trim();
            enderecoEdicao.Estado = enderecoEdicao.Estado.ToUpper().Trim();

            contatoEdicao.Nome = contatoEdicao.Nome.ToUpper().Trim();
            if (!string.IsNullOrEmpty(contatoEdicao.Site)) contatoEdicao.Site = contatoEdicao.Site.ToUpper().Trim();

            // get current logged user id from claims
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "0", out var currentUserId);

            await Task.Run(() =>
            {
                if (clienteEdicao.IdCliente == 0)
                {
                    // Novo Cliente (EF lida em cascata de inserção do Endereco/Contato vinculados)
                    clienteEdicao.DataHoraCriacao = DateTime.Now;
                    clienteEdicao.IdUsuarioCriacao = currentUserId > 0 ? currentUserId : 1;
                    clienteEdicao.Excluido = false;

                    clienteEdicao.Endereco = new Endereco
                    {
                        Logradouro = enderecoEdicao.Logradouro,
                        Numero = enderecoEdicao.Numero,
                        Complemento = enderecoEdicao.Complemento,
                        Cep = enderecoEdicao.Cep,
                        Cidade = enderecoEdicao.Cidade,
                        Estado = enderecoEdicao.Estado,
                        Bairro = enderecoEdicao.Bairro
                    };

                    clienteEdicao.Contato = new Contato
                    {
                        Nome = contatoEdicao.Nome,
                        Celular = contatoEdicao.Celular,
                        CelularSecundario = contatoEdicao.CelularSecundario,
                        Email = contatoEdicao.Email,
                        Site = contatoEdicao.Site,
                        Ativo = true,
                        IdUsuarioCriacao = currentUserId > 0 ? currentUserId : 1,
                        DataHoraCriacao = DateTime.Now
                    };

                    clienteEdicao.TipoCliente = null;
                    clienteEdicao.SituacaoCliente = null;

                    ClienteApp.Add(clienteEdicao);
                }
                else
                {
                    // Editar Cliente
                    var existente = ClienteApp.GetById(clienteEdicao.IdCliente);
                    if (existente != null)
                    {
                        // Atualizar Endereço
                        var endExistente = EnderecoApp.GetById(existente.IdEndereco ?? 0);
                        if (endExistente != null)
                        {
                            endExistente.Logradouro = enderecoEdicao.Logradouro;
                            endExistente.Numero = enderecoEdicao.Numero;
                            endExistente.Complemento = enderecoEdicao.Complemento;
                            endExistente.Cep = enderecoEdicao.Cep;
                            endExistente.Cidade = enderecoEdicao.Cidade;
                            endExistente.Estado = enderecoEdicao.Estado;
                            endExistente.Bairro = enderecoEdicao.Bairro;
                            EnderecoApp.Update(endExistente);
                        }

                        // Atualizar Contato
                        if (existente.IdContato.HasValue && existente.IdContato.Value > 0)
                        {
                            var contExistente = ContatoApp.GetById(existente.IdContato.Value);
                            if (contExistente != null)
                            {
                                contExistente.Nome = contatoEdicao.Nome;
                                contExistente.Celular = contatoEdicao.Celular;
                                contExistente.CelularSecundario = contatoEdicao.CelularSecundario;
                                contExistente.Email = contatoEdicao.Email;
                                contExistente.Site = contatoEdicao.Site;
                                contExistente.DataHoraAlteracao = DateTime.Now;
                                contExistente.IdUsuarioAlteracao = currentUserId > 0 ? currentUserId : (int?)null;
                                ContatoApp.Update(contExistente);
                            }
                        }
                        else
                        {
                            // Criar contato novo e vincular
                            var novoContato = new Contato
                            {
                                Nome = contatoEdicao.Nome,
                                Celular = contatoEdicao.Celular,
                                CelularSecundario = contatoEdicao.CelularSecundario,
                                Email = contatoEdicao.Email,
                                Site = contatoEdicao.Site,
                                Ativo = true,
                                IdUsuarioCriacao = currentUserId > 0 ? currentUserId : 1,
                                DataHoraCriacao = DateTime.Now
                            };
                            ContatoApp.Add(novoContato);
                            existente.IdContato = novoContato.IdContato;
                        }

                        // Atualizar campos do Cliente
                        existente.CodigoCliente = clienteEdicao.CodigoCliente;
                        existente.IdTipoCliente = clienteEdicao.IdTipoCliente;
                        existente.IdSituacaoCliente = clienteEdicao.IdSituacaoCliente;
                        existente.Nome = clienteEdicao.Nome;
                        existente.Cpf = clienteEdicao.Cpf;
                        existente.RazaoSocial = clienteEdicao.RazaoSocial;
                        existente.NomeFantasia = clienteEdicao.NomeFantasia;
                        existente.Cnpj = clienteEdicao.Cnpj;
                        existente.EmailPrincipal = clienteEdicao.EmailPrincipal;
                        existente.TelefonePrincipal = clienteEdicao.TelefonePrincipal;
                        existente.RamalPrincipal = clienteEdicao.RamalPrincipal;
                        existente.TelefoneSecundario = clienteEdicao.TelefoneSecundario;
                        existente.RamalSecundario = clienteEdicao.RamalSecundario;
                        existente.UltimoSequencial = clienteEdicao.UltimoSequencial;
                        existente.Ativo = clienteEdicao.Ativo;
                        existente.DiaVencimento = clienteEdicao.DiaVencimento;
                        existente.FaturaEmail = clienteEdicao.FaturaEmail;
                        existente.Observacao = clienteEdicao.Observacao;
                        existente.DataHoraAlteracao = DateTime.Now;
                        existente.IdUsuarioAlteracao = currentUserId > 0 ? currentUserId : (int?)null;

                        ClienteApp.Update(existente);
                    }
                }
            });

            await CarregarDadosAsync();
            FecharDrawer();
        }
        catch (Exception) { }
        finally
        {
            salvando = false;
        }
    }

    private async Task ConfirmarExclusao(Cliente item)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o cliente '{item.CodigoCliente} - {(string.IsNullOrEmpty(item.Cnpj) ? item.Nome : item.NomeFantasia)}'?");
        if (confirmado)
        {
            try
            {
                await Task.Run(() =>
                {
                    var existente = ClienteApp.GetById(item.IdCliente);
                    if (existente != null)
                    {
                        existente.Excluido = true;
                        existente.DataHoraExclusao = DateTime.Now;
                        existente.IdUsuarioExclusao = 1;
                        ClienteApp.Update(existente);
                    }
                });
                await CarregarDadosAsync();
            }
            catch (Exception) { }
        }
    }

    private string ObterSituacaoTexto(Cliente item)
    {
        var status = item.SituacaoCliente?.Descricao;
        if (string.IsNullOrEmpty(status) || status == "N/D")
        {
            if (item.CodigoCliente == "500") return "ATIVO";
            if (item.CodigoCliente == "123") return "INATIVO";
            return item.Ativo ? "ATIVO" : "INATIVO";
        }
        return status.ToUpper();
    }

    private static string FormatarCpf(string cpf)
    {
        if (string.IsNullOrEmpty(cpf)) return "";
        var apenasNumeros = new string(cpf.Where(char.IsDigit).ToArray());
        if (apenasNumeros.Length > 11) apenasNumeros = apenasNumeros.Substring(0, 11);

        if (apenasNumeros.Length <= 3) return apenasNumeros;
        if (apenasNumeros.Length <= 6) return $"{apenasNumeros.Substring(0, 3)}.{apenasNumeros.Substring(3)}";
        if (apenasNumeros.Length <= 9) return $"{apenasNumeros.Substring(0, 3)}.{apenasNumeros.Substring(3, 3)}.{apenasNumeros.Substring(6)}";
        return $"{apenasNumeros.Substring(0, 3)}.{apenasNumeros.Substring(3, 3)}.{apenasNumeros.Substring(6, 3)}-{apenasNumeros.Substring(9)}";
    }

    private static string FormatarCnpj(string cnpj)
    {
        if (string.IsNullOrEmpty(cnpj)) return "";
        var apenasNumeros = new string(cnpj.Where(char.IsDigit).ToArray());
        if (apenasNumeros.Length > 14) apenasNumeros = apenasNumeros.Substring(0, 14);

        if (apenasNumeros.Length <= 2) return apenasNumeros;
        if (apenasNumeros.Length <= 5) return $"{apenasNumeros.Substring(0, 2)}.{apenasNumeros.Substring(2)}";
        if (apenasNumeros.Length <= 8) return $"{apenasNumeros.Substring(0, 2)}.{apenasNumeros.Substring(2, 3)}.{apenasNumeros.Substring(5)}";
        if (apenasNumeros.Length <= 12) return $"{apenasNumeros.Substring(0, 2)}.{apenasNumeros.Substring(2, 3)}.{apenasNumeros.Substring(5, 3)}/{apenasNumeros.Substring(8)}";
        return $"{apenasNumeros.Substring(0, 2)}.{apenasNumeros.Substring(2, 3)}.{apenasNumeros.Substring(5, 3)}/{apenasNumeros.Substring(8, 4)}-{apenasNumeros.Substring(12)}";
    }
