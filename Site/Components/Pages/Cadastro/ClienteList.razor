@page "/Blazor/Cliente"
@attribute [Authorize]
@inject IClienteAppService ClienteApp
@inject ITipoClienteAppService TipoClienteApp
@inject ISituacaoClienteAppService SituacaoClienteApp
@inject IEnderecoAppService EnderecoApp
@inject IContatoAppService ContatoApp
@inject IUsuarioAppService UsuarioApp
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Millenium.Domain.Entity
@using System.Security.Claims

<PageTitle>Gestão de Clientes - Millenium</PageTitle>

<style>
    .search-toolbar-custom input::placeholder {
        color: #cbd5e1 !important;
        opacity: 0.85;
    }
</style>

<div class="dashboard-container" style="padding: 10px;">
    <!-- Cabeçalho Minimalista da Tela -->
    <div class="page-header-container" style="margin-bottom: 24px;">
        <h3 style="margin: 0; font-size: 24px; font-weight: 700; color: var(--dark-bg); font-family: 'Outfit', sans-serif;">Gestão de Clientes</h3>
        <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 14px;">Cadastre, gerencie e edite os perfis dos clientes do sistema.</p>
    </div>

    <!-- Toolbar de Busca e Filtros Integrada -->
    <div class="search-toolbar-custom" style="background-color: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
        <div class="toolbar-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="toolbar-title" style="font-weight: 700; font-size: 15px; color: var(--dark-bg); display: flex; align-items: center; gap: 8px; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-filter"></i> Filtros de Pesquisa
            </span>
            <button class="btn btn-primary" @onclick="AbrirNovoDrawer" style="display: flex; align-items: center; gap: 8px; border-radius: var(--radius-md); font-weight: 600; font-family: 'Outfit', sans-serif;">
                <i class="fa fa-user-plus"></i> Novo Cliente
            </button>
        </div>

        <form @onsubmit="Filtrar" style="margin: 0; padding: 0;">
            <div class="row">
                <div class="form-group col-md-3">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Nome / Razão Social</label>
                    <input type="text" @bind="filtroNome" @onkeyup="HandleFiltroEnter" class="form-control" placeholder="Nome completo ou fantasia..." style="border-radius: var(--radius-md); border-color: var(--border-color); text-transform: uppercase;" />
                </div>
                <div class="form-group col-md-2">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">CPF</label>
                    <input type="text" @bind="filtroCpf" @onkeyup="HandleFiltroEnter" class="form-control" placeholder="000.000.000-00" style="border-radius: var(--radius-md); border-color: var(--border-color);" />
                </div>
                <div class="form-group col-md-2">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">CNPJ</label>
                    <input type="text" @bind="filtroCnpj" @onkeyup="HandleFiltroEnter" class="form-control" placeholder="00.000.000/0001-00" style="border-radius: var(--radius-md); border-color: var(--border-color);" />
                </div>
                <div class="form-group col-md-2">
                    <label style="font-weight: 600; font-size: 13px; color: var(--text-muted);">Situação</label>
                    <select class="form-control" @bind="filtroSituacaoId" style="border-radius: var(--radius-md); border-color: var(--border-color);">
                        <option value="0">SELECIONE</option>
                        @foreach (var s in situacoes)
                        {
                            <option value="@s.IdSituacaoCliente">@s.Descricao</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-3" style="display: flex; align-items: flex-end; justify-content: flex-start; gap: 8px; height: 59px;">
                    <button type="submit" class="btn btn-primary" title="Buscar registros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md);">
                        <i class="fa fa-search"></i>
                    </button>
                    <button type="button" class="btn btn-default" @onclick="LimparFiltros" title="Limpar filtros" style="height: 38px; width: 44px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fa fa-rotate-left"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Tabela de Resultados -->
    @if (carregando)
    {
        <div style="padding: 60px; text-align: center; color: var(--text-muted);">
            <i class="fa fa-refresh fa-spin" style="font-size: 32px; margin-bottom: 16px; color: var(--primary-color);"></i>
            <p style="font-weight: 600;">Carregando registros...</p>
        </div>
    }
    else
    {
        <MilleniumTable TItem="Cliente" Items="clientesFiltrados" ColSpan="6" PageSize="10">
            <HeaderTemplate>
                <th style="width: 120px; padding: 12px 16px; text-align: left; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Código</th>
                <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Nome / Razão Social</th>
                <th style="width: 150px; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Situação</th>
                <th style="width: 120px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Ativo</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Editar</th>
                <th style="width: 100px; text-align: center; font-weight: 600; color: var(--text-muted); font-size: 13px; text-transform: uppercase;">Excluir</th>
            </HeaderTemplate>
            <RowTemplate Context="item">
                <td style="padding: 14px 16px; font-weight: 600; color: var(--primary-color);">@item.CodigoCliente</td>
                <td style="padding: 14px 16px; font-weight: 500; color: var(--dark-bg);">
                    @(string.IsNullOrEmpty(item.Cnpj) ? item.Nome : item.RazaoSocial)
                </td>
                <td style="padding: 14px 16px;">
                    @{
                        var sitTexto = ObterSituacaoTexto(item);
                        if (sitTexto == "ATIVO")
                        {
                            <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.2);">
                                ATIVO
                            </span>
                        }
                        else if (sitTexto == "INATIVO" || sitTexto == "CANCELADO")
                        {
                            <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.2);">
                                INATIVO
                            </span>
                        }
                        else
                        {
                            <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(245, 158, 11, 0.1); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.2);">
                                @sitTexto
                            </span>
                        }
                    }
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    @if (item.Ativo)
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.2);">
                            SIM
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-block; padding: 2px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.2);">
                            NÃO
                        </span>
                    }
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    <button class="btn btn-link" @onclick="() => AbrirEditarDrawer(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Editar">
                        <i class="fa fa-edit" style="font-size: 16px;"></i>
                    </button>
                </td>
                <td style="text-align: center; padding: 14px 16px;">
                    <button class="btn btn-link" @onclick="() => ConfirmarExclusao(item)" style="color: var(--primary-color); padding: 0; border: none; background: transparent;" title="Excluir">
                        <i class="fa fa-trash-o" style="font-size: 16px;"></i>
                    </button>
                </td>
            </RowTemplate>
        </MilleniumTable>
    }
</div>

<!-- Drawer de Cadastro / Edição -->
<MilleniumDrawer @bind-IsOpen="drawerAberto" Title="@drawerTitulo" Size="lg">
    <ChildContent>
        <EditForm Model="clienteEdicao" OnValidSubmit="SalvarCliente" style="display: flex; flex-direction: column; height: 100%;">
            <DataAnnotationsValidator />

            <div style="flex-grow: 1; padding-bottom: 20px; max-height: 72vh; overflow-y: auto; padding-right: 5px;">
                <!-- Abas internas no Drawer para agrupar as seções complexas -->
                <div style="display: flex; border-bottom: 1px solid var(--border-color); margin-bottom: 20px; gap: 10px;">
                    <button type="button" class="tab-btn @(abaDrawer == "dados" ? "active" : "")" @onclick='() => SetAbaDrawer("dados")' style="padding: 8px 16px; font-weight: 600; border: none; background: transparent; border-bottom: 2px solid @(abaDrawer == "dados" ? "var(--primary-color)" : "transparent"); color: @(abaDrawer == "dados" ? "var(--primary-color)" : "var(--text-muted)");">Dados do Cliente</button>
                    <button type="button" class="tab-btn @(abaDrawer == "endereco" ? "active" : "")" @onclick='() => SetAbaDrawer("endereco")' style="padding: 8px 16px; font-weight: 600; border: none; background: transparent; border-bottom: 2px solid @(abaDrawer == "endereco" ? "var(--primary-color)" : "transparent"); color: @(abaDrawer == "endereco" ? "var(--primary-color)" : "var(--text-muted)");">Endereço</button>
                    <button type="button" class="tab-btn @(abaDrawer == "contato" ? "active" : "")" @onclick='() => SetAbaDrawer("contato")' style="padding: 8px 16px; font-weight: 600; border: none; background: transparent; border-bottom: 2px solid @(abaDrawer == "contato" ? "var(--primary-color)" : "transparent"); color: @(abaDrawer == "contato" ? "var(--primary-color)" : "var(--text-muted)");">Contato Empresa</button>
                    <button type="button" class="tab-btn @(abaDrawer == "faturamento" ? "active" : "")" @onclick='() => SetAbaDrawer("faturamento")' style="padding: 8px 16px; font-weight: 600; border: none; background: transparent; border-bottom: 2px solid @(abaDrawer == "faturamento" ? "var(--primary-color)" : "transparent"); color: @(abaDrawer == "faturamento" ? "var(--primary-color)" : "var(--text-muted)");">Faturamento</button>
                </div>

                @if (abaDrawer == "dados")
                {
                    <div class="row">
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Código do Cliente" @bind-Value="clienteEdicao.CodigoCliente" Placeholder="EX: CLI-01..." Required="true" Maxlength="25" />
                        </div>
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Tipo de Cliente</label>
                            <select class="form-control" @bind="clienteEdicao.IdTipoCliente" required disabled="@(clienteEdicao.IdCliente > 0)" style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;">
                                <option value="">SELECIONE</option>
                                @foreach (var t in tiposCliente)
                                {
                                    <option value="@t.IdTipoCliente">@t.Descricao</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Situação</label>
                            <select class="form-control" @bind="clienteEdicao.IdSituacaoCliente" required style="border-radius: var(--radius-md); border-color: var(--border-color); height: 42px;">
                                <option value="">SELECIONE</option>
                                @foreach (var s in situacoes)
                                {
                                    <option value="@s.IdSituacaoCliente">@s.Descricao</option>
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-12" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Tipo de Cadastro</label>
                            <div style="display: flex; gap: 20px;">
                                <label style="font-weight: 500; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                    <input type="radio" name="radTipoRazao" checked="@(!tipoRazaoUI)" disabled="@(clienteEdicao.IdCliente > 0)" @onchange="() => SetTipoRazao(false)" style="accent-color: var(--primary-color);" /> Pessoa Física (CPF)
                                </label>
                                <label style="font-weight: 500; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                    <input type="radio" name="radTipoRazao" checked="@tipoRazaoUI" disabled="@(clienteEdicao.IdCliente > 0)" @onchange="() => SetTipoRazao(true)" style="accent-color: var(--primary-color);" /> Pessoa Jurídica (CNPJ)
                                </label>
                            </div>
                        </div>

                        @if (!tipoRazaoUI)
                        {
                            <div class="form-group col-md-8" style="margin-bottom: 15px;">
                                <MilleniumInput Label="Nome Completo" @bind-Value="clienteEdicao.Nome" Placeholder="NOME COMPLETO..." Required="true" Maxlength="255" />
                            </div>
                            <div class="form-group col-md-4" style="margin-bottom: 15px;">
                                <MilleniumInput Label="CPF" @bind-Value="clienteEdicao.Cpf" Placeholder="000.000.000-00" Required="true" Maxlength="14" />
                            </div>
                        }
                        else
                        {
                            <div class="form-group col-md-6" style="margin-bottom: 15px;">
                                <MilleniumInput Label="Razão Social" @bind-Value="clienteEdicao.RazaoSocial" Placeholder="RAZÃO SOCIAL..." Required="true" Maxlength="255" />
                            </div>
                            <div class="form-group col-md-6" style="margin-bottom: 15px;">
                                <MilleniumInput Label="Nome Fantasia" @bind-Value="clienteEdicao.NomeFantasia" Placeholder="NOME FANTASIA..." Required="true" Maxlength="255" />
                            </div>
                            <div class="form-group col-md-6" style="margin-bottom: 15px;">
                                <MilleniumInput Label="CNPJ" @bind-Value="clienteEdicao.Cnpj" Placeholder="00.000.000/0001-00" Required="true" Maxlength="18" />
                            </div>
                        }

                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Email Principal" @bind-Value="clienteEdicao.EmailPrincipal" Placeholder="EMAIL@EMPRESA.COM" Required="true" Maxlength="255" />
                        </div>
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Telefone Principal" @bind-Value="clienteEdicao.TelefonePrincipal" Placeholder="(00) 00000-0000" Required="true" Maxlength="15" />
                        </div>
                        <div class="form-group col-md-2" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Ramal" @bind-Value="clienteEdicao.RamalPrincipal" Placeholder="RAMAL" Required="false" Maxlength="5" />
                        </div>

                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Telefone Secundário" @bind-Value="clienteEdicao.TelefoneSecundario" Placeholder="(00) 0000-0000" Required="false" Maxlength="15" />
                        </div>
                        <div class="form-group col-md-2" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Ramal" @bind-Value="clienteEdicao.RamalSecundario" Placeholder="RAMAL" Required="false" Maxlength="5" />
                        </div>

                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Último Número de Solicitação</label>
                            <input type="number" min="0" @bind="clienteEdicao.UltimoSequencial" class="form-control" style="height: 42px; border-radius: var(--radius-md); border-color: var(--border-color);" placeholder="EX: 99 (PRÓXIMO SERÁ 100)" />
                        </div>

                        <div class="form-group col-md-12" style="margin-bottom: 15px; display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                            <InputCheckbox @bind-Value="clienteEdicao.Ativo" id="chkClienteAtivo" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;" />
                            <label for="chkClienteAtivo" style="font-weight: 600; font-size: 14px; margin: 0; cursor: pointer; color: var(--dark-bg);">
                                Cliente ativo e habilitado para consultas no sistema
                            </label>
                        </div>
                    </div>
                }
                else if (abaDrawer == "endereco")
                {
                    <div class="row">
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <MilleniumInput Label="CEP" @bind-Value="enderecoEdicao.Cep" Placeholder="00000-000" Required="true" Maxlength="9" />
                        </div>
                        <div class="form-group col-md-8" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Logradouro" @bind-Value="enderecoEdicao.Logradouro" Placeholder="RUA, AVENIDA..." Required="true" Maxlength="255" />
                        </div>
                        <div class="form-group col-md-3" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Número" @bind-Value="enderecoEdicao.Numero" Placeholder="Nº" Required="true" Maxlength="10" />
                        </div>
                        <div class="form-group col-md-9" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Complemento" @bind-Value="enderecoEdicao.Complemento" Placeholder="APTO, SALA..." Required="false" Maxlength="150" />
                        </div>
                        <div class="form-group col-md-4" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Bairro" @bind-Value="enderecoEdicao.Bairro" Placeholder="BAIRRO" Required="true" Maxlength="100" />
                        </div>
                        <div class="form-group col-md-5" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Cidade" @bind-Value="enderecoEdicao.Cidade" Placeholder="CIDADE" Required="true" Maxlength="150" />
                        </div>
                        <div class="form-group col-md-3" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Estado (UF)" @bind-Value="enderecoEdicao.Estado" Placeholder="UF" Required="true" Maxlength="2" />
                        </div>
                    </div>
                }
                else if (abaDrawer == "contato")
                {
                    <div class="row">
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Nome do Contato" @bind-Value="contatoEdicao.Nome" Placeholder="NOME COMPLETO DO CONTATO..." Required="true" Maxlength="255" />
                        </div>
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Departamento" @bind-Value="contatoEdicao.Site" Placeholder="EX: RECURSOS HUMANOS, COMPLIANCE..." Required="false" Maxlength="255" />
                        </div>
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Email do Contato" @bind-Value="contatoEdicao.Email" Placeholder="EMAIL.CONTATO@EMPRESA.COM" Required="true" Maxlength="255" />
                        </div>
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <MilleniumInput Label="Celular do Contato" @bind-Value="contatoEdicao.Celular" Placeholder="(00) 90000-0000" Required="true" Maxlength="15" />
                        </div>
                    </div>
                }
                else if (abaDrawer == "faturamento")
                {
                    <div class="row">
                        <div class="form-group col-md-6" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Dia do Vencimento da Fatura</label>
                            <input type="number" min="1" max="31" @bind="clienteEdicao.DiaVencimento" class="form-control" required style="height: 42px; border-radius: var(--radius-md); border-color: var(--border-color);" />
                        </div>
                        <div class="form-group col-md-6" style="margin-bottom: 15px; display: flex; align-items: center; gap: 8px; margin-top: 28px;">
                            <InputCheckbox @bind-Value="clienteEdicao.FaturaEmail" id="chkFaturaEmail" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;" />
                            <label for="chkFaturaEmail" style="font-weight: 600; font-size: 14px; margin: 0; cursor: pointer; color: var(--dark-bg);">
                                Enviar Fatura por E-mail
                            </label>
                        </div>
                        <div class="form-group col-md-12" style="margin-bottom: 15px;">
                            <label style="font-weight: 600; font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;">Observações Internas</label>
                            <textarea @bind="clienteEdicao.Observacao" class="form-control" style="height: 100px; border-radius: var(--radius-md); border-color: var(--border-color); resize: vertical;"></textarea>
                        </div>
                    </div>
                }
            </div>

            <div style="padding: 16px 0 0 0; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 12px; background-color: #ffffff;">
                <button type="button" class="btn btn-default" @onclick="FecharDrawer" style="border-radius: var(--radius-md); border-color: var(--border-color); font-weight: 600;">Cancelar</button>
                <MilleniumButton Type="submit" Text="Salvar" Icon="fa fa-save" IsLoading="@salvando" LoadingText="Salvando..." Style="primary" StyleAttribute="border-radius: var(--radius-md); font-weight: 600;" />
            </div>
        </EditForm>
    </ChildContent>
</MilleniumDrawer>

@code {
    private bool carregando = true;
    private bool salvando = false;
    private bool drawerAberto = false;
    private string drawerTitulo = "";
    private string abaDrawer = "dados";

    private string filtroNome = "";
    private string _filtroCpf = "";
    private string filtroCpf
    {
        get => _filtroCpf;
        set => _filtroCpf = FormatarCpf(value);
    }
    private string _filtroCnpj = "";
    private string filtroCnpj
    {
        get => _filtroCnpj;
        set => _filtroCnpj = FormatarCnpj(value);
    }
    private int filtroSituacaoId = 0;

    private List<Cliente> todosClientes = new();
    private List<Cliente> clientesFiltrados = new();
    private List<TipoCliente> tiposCliente = new();
    private List<SituacaoCliente> situacoes = new();

    private Cliente clienteEdicao = new();
    private Endereco enderecoEdicao = new();
    private Contato contatoEdicao = new();
    private bool tipoRazaoUI = false; // false = PF, true = PJ

    protected override async Task OnInitializedAsync()
    {
        var userLogin = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
        if (!string.IsNullOrEmpty(userLogin))
        {
            var usr = UsuarioApp.ObterUsuarioPeloNome(userLogin);
            if (usr?.IdNivel == 3)
            {
                NavigationManager.NavigateTo("/Blazor/Solicitacao");
                return;
            }
        }

        await CarregarDropdownsAsync();
        await CarregarDadosAsync();
    }

    private async Task CarregarDropdownsAsync()
    {
        try
        {
            await Task.Run(() =>
            {
                tiposCliente = TipoClienteApp.GetAll()?.Where(x => x.Excluido != true && x.Ativo == true).OrderBy(x => x.Descricao).ToList() ?? new List<TipoCliente>();
                situacoes = SituacaoClienteApp.GetAll()?.OrderBy(x => x.Descricao).ToList() ?? new List<SituacaoCliente>();
            });
        }
        catch { }
    }

    private async Task CarregarDadosAsync()
    {
        carregando = true;
        try
        {
            await Task.Run(() =>
            {
                todosClientes = ClienteApp.GetAll()
                    ?.Where(x => x.Excluido != true)
                    .OrderBy(x => x.Nome)
                    .ToList() ?? new List<Cliente>();

                // Mapear relacionamentos
                foreach (var c in todosClientes)
                {
                    if (c.IdSituacaoCliente > 0 && c.SituacaoCliente == null)
                    {
                        c.SituacaoCliente = situacoes.FirstOrDefault(s => s.IdSituacaoCliente == c.IdSituacaoCliente);
                    }
                }
            });
            Filtrar();
        }
        catch (Exception) { }
        finally
        {
            carregando = false;
        }
    }

    private void Filtrar()
    {
        var query = todosClientes.AsQueryable();

        if (!string.IsNullOrWhiteSpace(filtroNome))
        {
            query = query.Where(x => (x.Nome != null && x.Nome.Contains(filtroNome, StringComparison.OrdinalIgnoreCase)) ||
                                     (x.RazaoSocial != null && x.RazaoSocial.Contains(filtroNome, StringComparison.OrdinalIgnoreCase)) ||
                                     (x.NomeFantasia != null && x.NomeFantasia.Contains(filtroNome, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(filtroCpf))
        {
            query = query.Where(x => x.Cpf == filtroCpf);
        }

        if (!string.IsNullOrWhiteSpace(filtroCnpj))
        {
            query = query.Where(x => x.Cnpj == filtroCnpj);
        }

        if (filtroSituacaoId > 0)
        {
            query = query.Where(x => x.IdSituacaoCliente == filtroSituacaoId);
        }

        clientesFiltrados = query.ToList();
    }

    private void LimparFiltros()
    {
        filtroNome = "";
        filtroCpf = "";
        filtroCnpj = "";
        filtroSituacaoId = 0;
        Filtrar();
    }

    private void HandleFiltroEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Filtrar();
        }
    }

